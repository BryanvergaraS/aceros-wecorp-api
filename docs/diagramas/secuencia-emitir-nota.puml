@startuml secuencia-emitir-nota
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 14
skinparam titleFontSize 18
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #1F3A5F
skinparam ArrowThickness 1.1
skinparam class {
  BackgroundColor #EEF3F9
  BorderColor #1F3A5F
  HeaderBackgroundColor #DCE3EC
}
skinparam entity {
  BackgroundColor #EEF3F9
  BorderColor #1F3A5F
}
skinparam package {
  BorderColor #7A8A9E
  BackgroundColor #FAFBFD
}
skinparam note {
  BackgroundColor #FFFDF2
  BorderColor #B8A86A
}
skinparam sequence {
  ParticipantBackgroundColor #EEF3F9
  ParticipantBorderColor #1F3A5F
  LifeLineBorderColor #7A8A9E
  ActorBorderColor #1F3A5F
  GroupBorderColor #7A8A9E
}
skinparam state {
  BackgroundColor #EEF3F9
  BorderColor #1F3A5F
}
skinparam database {
  BackgroundColor #FFF4E8
  BorderColor #E07B1A
}
skinparam node {
  BackgroundColor #FAFBFD
  BorderColor #1F3A5F
}
title Secuencia 2 — Emitir nota de venta (CU07 + CU08; RF07, RF08)
autonumber
actor "Vendedor" as U
participant "Cliente web\n(React)" as WEB
participant "API de Ventas\nNotasVentaController" as VEN
participant "NotaVentaService" as SRV
participant "CatalogoClient\n(IHttpClientFactory)" as CLI
participant "API de Catálogo\nStockController" as CAT
database "WeCorpCatalogoDB" as DBC
database "WeCorpVentasDB" as DBV

U -> WEB : Elige cliente, productos y cantidades
WEB -> VEN : POST /ventas/api/v1/notas-venta\nBearer JWT { clienteId, lineas[] }
VEN -> VEN : Valida JWT (firma, emisor, audiencia,\nexpiración) y rol Vendedor/Administrador
VEN -> SRV : CrearAsync(dto, vendedorId, vendedorNombre)
SRV -> DBV : ¿Existe el cliente?
DBV --> SRV : Cliente
SRV -> CLI : DescontarStockAsync(lineas agrupadas)
CLI -> CAT : POST /api/v1/productos/stock/descontar\n(reenvía el mismo JWT; timeout 5 s)
CAT -> DBC : SELECT productos; valida activo y stock
alt stock suficiente
  CAT -> DBC : UPDATE Stock = Stock - cantidad
  CAT --> CLI : 200 { lineas: sku, nombre, precioUnitario, stockRestante }
  CLI --> SRV : Precios vigentes
  SRV -> DBV : INSERT NotaVenta (Pendiente) + DetalleNotasVenta\n(copia de SKU, nombre y precio); Folio NV-000123
  DBV --> SRV : Id
  SRV --> VEN : NotaVentaDto
  VEN --> WEB : 201 Created + Location
  WEB --> U : "Nota NV-000123 emitida"
else stock insuficiente
  CAT --> CLI : 422 ProblemDetails
  CLI --> SRV : BusinessRuleException
  VEN --> WEB : 422 "Stock insuficiente para ..."
  WEB --> U : Muestra el producto sin stock
end
@enduml
