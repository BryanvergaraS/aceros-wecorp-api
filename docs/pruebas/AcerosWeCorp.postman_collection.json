    {
      "name": "1. Autenticación (API de Catálogo)",
      "item": [
        {
          "name": "Login Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login Administrador: responde 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json(); pm.collectionVariables.set('tokenAdmin', j.token);",
                  "pm.test('Rol Administrador', () => pm.expect(j.usuario.rol).to.eql('Administrador'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{catalogoUrl}}/api/v1/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
