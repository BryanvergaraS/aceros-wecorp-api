# ============================================================
#  Variables de entorno del sistema Aceros We-Corp
#  1. Copie este archivo como .env (el .env está en .gitignore y NUNCA se sube).
#  2. Complete los valores. Aquí no hay valores reales.
# ============================================================

# --- JWT (lo emite la API de Catálogo y lo validan ambas APIs) ---
# Mínimo 32 caracteres aleatorios.
Jwt__Key=

# --- Cadenas de conexión (ejecución local con dotnet run) ---
# Ejemplo de formato para SQL Server Express con autenticación de Windows:
#   Server=.\SQLEXPRESS;Database=WeCorpCatalogoDB;Trusted_Connection=True;TrustServerCertificate=True
ConnectionStrings__CatalogoDb=
#   Server=.\SQLEXPRESS;Database=WeCorpVentasDB;Trusted_Connection=True;TrustServerCertificate=True
ConnectionStrings__VentasDb=

# --- Integración: URL de la API de Catálogo que consume la API de Ventas (local) ---
Catalogo__BaseUrl=http://localhost:5081

# --- Usuarios iniciales que crea la API de Catálogo al arrancar ---
Seed__AdminEmail=
Seed__AdminPassword=
Seed__VendedorEmail=
Seed__VendedorPassword=

# --- Solo para docker compose: contraseña del usuario sa de SQL Server ---
# Debe tener mayúsculas, minúsculas, números y símbolos (mínimo 8 caracteres).
SA_PASSWORD=
